# Copy to .env (git-ignored) and fill in. Never commit a real secret.

# --- HF / Kaggle / MLflow (only needed for training and model upload) ---------
HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_EXPERIMENT_NAME=

# --- Application metadata and logging -----------------------------------------
APP_NAME=PII Masking Service
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# --- Release identity (contract v1.2 sections 2 and 7) ------------------------
# /version and every masked response report these. Each value must be immutable
# and describe what is actually loaded now -- a moving label such as `latest`,
# `champion`, or `fused-xlmr-final` is refused at startup. Any value left unset
# is reported as `unknown`.
#
# SERVICE_RELEASE  released API version, such as 1.3.0
# GIT_SHA          40-character commit hash of the source
# IMAGE_DIGEST     sha256:<64 hex> of the deployed image, known after the push
# MODEL_VERSION    immutable model version (e.g. an MLflow numeric version)
# MODEL_DIGEST     sha256:<64 hex> of the exact deployed model artifact
# The production core is the fine-tuned MedRoBERTa + Dutch regex detector.
SERVICE_NAME=pii-medroberta-masker
MODEL_NAME=pii-medroberta-nl
SERVICE_RELEASE=
GIT_SHA=
IMAGE_DIGEST=
# In production set MODEL_VERSION to the immutable MLflow numeric version, not
# the "medroberta-nl-1" label (contract v1.2 section 2 requires an immutable id).
MODEL_VERSION=
MODEL_DIGEST=

# --- Authentication -----------------------------------------------------------
# The bearer token every /v1/mask call must present. Replace this placeholder
# and inject the production secret at runtime.
SERVICE_TOKEN=replace-with-a-long-random-secret

# --- Model selection ----------------------------------------------------------
# Which in-process masker version to load. `medroberta-nl-1` is the production
# core: the fine-tuned Dutch MedRoBERTa token-classifier + Presidio + Dutch
# regex (requires the model stack in backend/requirements.txt). Use the
# lightweight `regex-poc-1` only for a dependency-free smoke test or CI.
MASKING_MODEL_VERSION=medroberta-nl-1

# Where the MedRoBERTa weights come from. On an isolated network the container
# cannot reach the Hub, so mount the weights locally and point PII_MODEL_DIR at
# them; otherwise they download from HF_MODEL_REPO on first use.
HF_MODEL_REPO=ziadosama/pii-medroberta-nl
PII_MODEL_DIR=

# Optional: load the MLflow-packaged MedRoBERTa model instead of the in-process
# masker. e.g. models:/pii-medroberta-nl/17  or  runs:/<run-id>/model
MODEL_URI=

# --- Limits and concurrency (contract v1.2 sections 3 and 6) ------------------
MAX_UPLOAD_SIZE_BYTES=10485760
# Masking runs at most this many documents at once. A further call gets 429 with
# Retry-After. The pilot starts at one or two concurrent NiFi calls per team.
MAX_CONCURRENT_MASKS=2
